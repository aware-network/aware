class Api {
    // Relationships
    api_graphs ApiGraph[]
    api_capabilities ApiCapability[]
    api_views ApiView[]

    // Attributes
    name String key
    description String?

    fn create construct (name String key, description String? = null) -> Api {
        """
        Create deterministic public/vendor API identity.
        """
    }

    fn create_api_graph (
        object_config_graph_id UUID,
        description String? = null
    ) -> ApiGraph {
        """
        Create one API graph bridge under this Api.
        """
        let created = construct api_graphs.create(
            object_config_graph_id = object_config_graph_id,
            description = description,
        )
    }

    fn create_capability (
        name String,
        description String? = null
    ) -> ApiCapability {
        """
        Create one named reusable API capability contract under this Api identity.
        """
        let created = construct api_capabilities.create(
            name = name,
            description = description,
        )
    }

    fn create_view (
        name String,
        object_projection_graph_observable_id UUID,
        state_model_id UUID,
        view_ref String,
        view_key String? = null,
        description String? = null
    ) -> ApiView {
        """
        Create one API-owned readable view-state contract under this Api identity.
        """
        let created = construct api_views.create(
            name = name,
            object_projection_graph_observable_id = object_projection_graph_observable_id,
            state_model_id = state_model_id,
            view_ref = view_ref,
            view_key = view_key,
            description = description,
        )
    }
}

ann api.Api identity standalone
ann api.Api::api_views load eager
