// Settle a reserved smart-contract operation through a deterministic saga.
//
// Sequence (all commit-backed):
// 1) SmartContract.validate_settlement_wallet_transitions_canonical
// 2) SmartContract.prepare_settlement_canonical
// 3) Escrow.release
// 4) SmartContract.finalize_settlement_canonical
// 5) Finance posting rail (`economy:ReconcileTransferWalletBalances_v1`)
//
// Security contract:
// - No caller-provided `final_cost` symbol is accepted.
// - Smart-contract finalization derives final cost from reservation state.
// - Wallet reconciliation is fail-closed/idempotent via Finance-owned posting.
// - Conservation is fail-closed: payer debit == receiver credit == reservation.max_cost.
//
// Required symbols (v2):
// - plan.escrow_id
// - plan.reconcile_transfer_wallet_balances_invocation_plan_artifact

program SettleSmartContractReservation_v2 {
    actor economy_system system

    port smart_contract_smart_contract_id smart_contract {
        node main smart_contract(smart_contract=smart_contract_id)
        node escrow escrow(escrow=escrow_id)
    }
    port wallet_payer_wallet_id wallet {
        node main wallet(wallet=payer_wallet_id)
    }
    port wallet_receiver_wallet_id wallet {
        node main wallet(wallet=receiver_wallet_id)
    }

    input smart_contract_id from plan.smart_contract_id
    input escrow_id from plan.escrow_id
    let permit_id = plan.permit_id
    let reservation_id = plan.reservation_id
    let payer_finance_entity_id = plan.payer_finance_entity_id
    input payer_wallet_id from plan.payer_wallet_id
    let payer_wallet_public_id = plan.payer_wallet_public_id
    let payer_expected_coin_balance = plan.payer_expected_coin_balance
    let payer_new_coin_balance = plan.payer_new_coin_balance
    let receiver_finance_entity_id = plan.receiver_finance_entity_id
    input receiver_wallet_id from plan.receiver_wallet_id
    let receiver_wallet_public_id = plan.receiver_wallet_public_id
    let receiver_expected_coin_balance = plan.receiver_expected_coin_balance
    let receiver_new_coin_balance = plan.receiver_new_coin_balance
    let coin_id = plan.coin_id
    let payer_wallet_branch_id = plan.wallet_payer_wallet_id_branch_id
    let receiver_wallet_branch_id = plan.wallet_receiver_wallet_id_branch_id
    let reconcile_transfer_wallet_balances_invocation_plan_artifact = plan.reconcile_transfer_wallet_balances_invocation_plan_artifact

    bind smart_contract_smart_contract_id smart_contract.main
    economy_system call program.port.smart_contract_smart_contract_id.projection_node.main smart_contract.SmartContract.validate_settlement_wallet_transitions_canonical(
        permit_id=permit_id,
        reservation_id=reservation_id,
        payer_expected_coin_balance=payer_expected_coin_balance,
        payer_new_coin_balance=payer_new_coin_balance,
        receiver_expected_coin_balance=receiver_expected_coin_balance,
        receiver_new_coin_balance=receiver_new_coin_balance,
        coin_id=coin_id
    )

    economy_system call program.port.smart_contract_smart_contract_id.projection_node.main smart_contract.SmartContract.prepare_settlement_canonical(
        permit_id=permit_id,
        reservation_id=reservation_id,
        payer_finance_entity_id=payer_finance_entity_id,
        payer_wallet_public_id=payer_wallet_public_id,
        receiver_finance_entity_id=receiver_finance_entity_id,
        receiver_wallet_public_id=receiver_wallet_public_id,
        coin_id=coin_id
    )

    bind smart_contract_smart_contract_id smart_contract.main
    economy_system call escrow escrow.Escrow.release()

    bind smart_contract_smart_contract_id smart_contract.main
    economy_system call program.port.smart_contract_smart_contract_id.projection_node.main smart_contract.SmartContract.finalize_settlement_canonical(
        permit_id=permit_id,
        reservation_id=reservation_id,
        payer_finance_entity_id=payer_finance_entity_id,
        payer_wallet_public_id=payer_wallet_public_id,
        receiver_finance_entity_id=receiver_finance_entity_id,
        receiver_wallet_public_id=receiver_wallet_public_id,
        coin_id=coin_id
    )

    bind wallet_payer_wallet_id wallet.main
    economy_system call program.port.wallet_payer_wallet_id.projection_node plan.apply_program_ref(
        program_ref="economy:ReconcileTransferWalletBalances_v1",
        symbols=kernel.symbols(
            "plan.invocation_plan_artifact",
            reconcile_transfer_wallet_balances_invocation_plan_artifact,
            "plan.source_wallet_id",
            payer_wallet_id,
            "plan.source_expected_coin_balance",
            payer_expected_coin_balance,
            "plan.source_new_coin_balance",
            payer_new_coin_balance,
            "plan.target_wallet_id",
            receiver_wallet_id,
            "plan.target_expected_coin_balance",
            receiver_expected_coin_balance,
            "plan.target_new_coin_balance",
            receiver_new_coin_balance,
            "plan.coin_id",
            coin_id,
            "plan.wallet_source_wallet_id_branch_id",
            payer_wallet_branch_id,
            "plan.wallet_target_wallet_id_branch_id",
            receiver_wallet_branch_id
        )
    )
}
