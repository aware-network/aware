// Apply the canonical Finance-owned balance-posting rail for a bilateral transfer.
//
// Required symbols:
// - plan.source_wallet_id
// - plan.source_expected_coin_balance
// - plan.source_new_coin_balance
// - plan.target_wallet_id
// - plan.target_expected_coin_balance
// - plan.target_new_coin_balance
// - plan.coin_id
//
// Contract (v1):
// - Finance owns the shared posting/application rail.
// - Consumers provide already-validated expected -> new absolute balances.
// - Status alone does not post; posting is explicit through this program.
// - Idempotent on rerun via Wallet.reconcile_coin_balance semantics.

program ReconcileTransferWalletBalances_v1 {
    actor economy_system system

    port wallet_source_wallet_id wallet {
        node main wallet(wallet=source_wallet_id)
    }
    port wallet_target_wallet_id wallet {
        node main wallet(wallet=target_wallet_id)
    }

    input source_wallet_id from plan.source_wallet_id
    let source_expected_coin_balance = plan.source_expected_coin_balance
    let source_new_coin_balance = plan.source_new_coin_balance
    input target_wallet_id from plan.target_wallet_id
    let target_expected_coin_balance = plan.target_expected_coin_balance
    let target_new_coin_balance = plan.target_new_coin_balance
    let coin_id = plan.coin_id

    bind wallet_source_wallet_id wallet.main
    economy_system call program.port.wallet_source_wallet_id.projection_node wallet.Wallet.reconcile_coin_balance(
        coin_id=coin_id,
        expected_balance=source_expected_coin_balance,
        new_balance=source_new_coin_balance
    )

    bind wallet_target_wallet_id wallet.main
    economy_system call program.port.wallet_target_wallet_id.projection_node wallet.Wallet.reconcile_coin_balance(
        coin_id=coin_id,
        expected_balance=target_expected_coin_balance,
        new_balance=target_new_coin_balance
    )
}
