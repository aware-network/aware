// Ensure deterministic economy ActorRole binding scoped from a target domain branch.
//
// Required symbols:
// - plan.actor_id
// - plan.actor_identity_branch_id
// - plan.role_config_name
// - plan.economy_domain_branch_id
//
// Contract (v1):
// - Delegates to identity canonical binding rail.
// - OIGI is derived from `plan.economy_domain_branch_id`.
// - Idempotent on rerun.

program EnsureEconomyActorRoleBindingFromBranch_v1 {
    actor economy_system system

    port role_actor_identity_branch_id role {
        node main role(role=actor_identity_branch_id)
    }

    let actor_id = plan.actor_id
    input actor_identity_branch_id from plan.actor_identity_branch_id
    let role_config_name = plan.role_config_name
    let economy_domain_branch_id = plan.economy_domain_branch_id

    bind role_actor_identity_branch_id role.main

    economy_system call program.port.role_actor_identity_branch_id.projection_node plan.apply_program_ref(
        program_ref="identity:EnsureActorRoleBindingFromBranch_v1",
        symbols=kernel.symbols(
            "plan.actor_id",
            actor_id,
            "plan.actor_identity_branch_id",
            actor_identity_branch_id,
            "plan.role_config_name",
            role_config_name,
            "plan.object_instance_graph_domain_branch_id",
            economy_domain_branch_id
        )
    )
}
