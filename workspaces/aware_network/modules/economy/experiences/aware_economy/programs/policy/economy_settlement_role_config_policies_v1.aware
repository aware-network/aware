// Install canonical ActorRole tool-policy entries for economy settlement rail.
//
// Required symbols:
// - plan.role_config_name
//
// Optional symbols:
// - plan.role_config_description
//
// Contract (v1):
// - Installs function-level policy edges needed by settlement v2 orchestration.
// - Uses identity canonical policy installer (`identity:RoleConfigToolPolicies_v1`).
// - Idempotent on rerun (role-config constructor/upsert semantics).

program EconomySettlementRoleConfigPolicies_v1 {
    actor economy_system system

    port role_config_role_config_id role_config {
        node main role_config(role_config=role_config_id)
    }

    let role_config_name = plan.role_config_name
    let role_config_description = plan.role_config_description
    input role_config_id from role_config_id default identity.stable_role_config_id(name=role_config_name)

    bind role_config_role_config_id role_config.main

    economy_system call program.port.role_config_role_config_id.projection_node plan.apply_program_ref(
        program_ref="identity:RoleConfigToolPolicies_v1",
        symbols=kernel.symbols(
            "plan.role_config_name",
            role_config_name,
            "plan.role_config_description",
            role_config_description,
            "plan.class_name",
            "SmartContract",
            "plan.function_name",
            "validate_settlement_wallet_transitions_canonical"
        )
    )

    economy_system call program.port.role_config_role_config_id.projection_node plan.apply_program_ref(
        program_ref="identity:RoleConfigToolPolicies_v1",
        symbols=kernel.symbols(
            "plan.role_config_name",
            role_config_name,
            "plan.role_config_description",
            role_config_description,
            "plan.class_name",
            "SmartContract",
            "plan.function_name",
            "prepare_settlement_canonical"
        )
    )

    economy_system call program.port.role_config_role_config_id.projection_node plan.apply_program_ref(
        program_ref="identity:RoleConfigToolPolicies_v1",
        symbols=kernel.symbols(
            "plan.role_config_name",
            role_config_name,
            "plan.role_config_description",
            role_config_description,
            "plan.class_name",
            "Escrow",
            "plan.function_name",
            "release"
        )
    )

    economy_system call program.port.role_config_role_config_id.projection_node plan.apply_program_ref(
        program_ref="identity:RoleConfigToolPolicies_v1",
        symbols=kernel.symbols(
            "plan.role_config_name",
            role_config_name,
            "plan.role_config_description",
            role_config_description,
            "plan.class_name",
            "SmartContract",
            "plan.function_name",
            "finalize_settlement_canonical"
        )
    )

    economy_system call program.port.role_config_role_config_id.projection_node plan.apply_program_ref(
        program_ref="identity:RoleConfigToolPolicies_v1",
        symbols=kernel.symbols(
            "plan.role_config_name",
            role_config_name,
            "plan.role_config_description",
            role_config_description,
            "plan.class_name",
            "Wallet",
            "plan.function_name",
            "reconcile_coin_balance"
        )
    )
}
