// Ensure one provider-neutral direct-denomination external-capital route.
//
// The provider FinanceEntity must already exist. This program commits only
// Economy denomination and routing truth; provider endpoints and secrets stay
// in the connector/service environment.

program EnsureExternalCapitalProviderRoute_v0Config(
    provider_finance_entity_id UUID = plan.provider_finance_entity_id,
    provider_key String = plan.provider_key,
    provider_label String = plan.provider_label,
    route_key String = plan.route_key,
    coin_symbol String = plan.coin_symbol,
    coin_name String = plan.coin_name,
    coin_decimals Int = plan.coin_decimals,
    external_currency String = plan.external_currency,
    external_minor_unit_exponent Int = plan.external_minor_unit_exponent,
    min_external_amount_minor Int = plan.min_external_amount_minor,
    max_external_amount_minor Int = plan.max_external_amount_minor,
    coin_id UUID = economy.stable_coin_id(symbol=coin_symbol),
    provider_config_id UUID = economy.stable_external_capital_provider_config_id(
        provider_finance_entity_id=provider_finance_entity_id,
        provider_key=provider_key
    )
) {
    actor economy_system system

    port coin_coin_id coin {
        node coin coin.Coin(coin=coin_id)
    }
    port provider_config_provider_config_id external_capital_provider_config {
        node provider_config external_capital.ExternalCapitalProviderConfig(
            external_capital_provider_config=provider_config_id
        )
    }
}

program EnsureExternalCapitalProviderRoute_v0 impl EnsureExternalCapitalProviderRoute_v0Config {
    bind coin_coin_id coin.main
    economy_system call coin coin.Coin.build(
        symbol=coin_symbol,
        name=coin_name,
        type=fiat,
        decimals=coin_decimals,
    )

    bind provider_config_provider_config_id external_capital_provider_config.main
    economy_system call provider_config external_capital.ExternalCapitalProviderConfig.build(
        provider_finance_entity_id=provider_finance_entity_id,
        provider_key=provider_key,
        label=provider_label
    )
    economy_system call provider_config external_capital.ExternalCapitalProviderConfig.add_route(
        route_key=route_key,
        target_coin_id=coin_id,
        external_currency=external_currency,
        external_minor_unit_exponent=external_minor_unit_exponent,
        conversion_mode=direct_denomination,
        min_external_amount_minor=min_external_amount_minor,
        max_external_amount_minor=max_external_amount_minor
    )
}
