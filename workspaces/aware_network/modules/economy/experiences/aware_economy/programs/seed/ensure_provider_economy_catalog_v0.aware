// Ensure provider FinanceEntity, Wallet, and baseline SmartContract catalog.
//
// Required symbols:
// - plan.provider_identity_id
// - plan.provider_actor_id
//
// Idempotency:
// - Constructor calls are lane-head guarded by the seed executor.

program EnsureProviderEconomyCatalog_v0 {
    actor economy_system system

    port wallet_wallet_id wallet {
        node main wallet(wallet=wallet_id)
    }
    port finance_entity_provider_finance_entity_id finance_entity {
        node main finance_entity(finance_entity=provider_finance_entity_id)
    }
    port smart_contract_config_smart_contract_config_id smart_contract_config {
        node main smart_contract_config(smart_contract_config=smart_contract_config_id)
    }
    port smart_contract_smart_contract_id smart_contract {
        node main smart_contract(smart_contract=smart_contract_id)
    }

    let provider_identity_id = plan.provider_identity_id
    let provider_actor_id = plan.provider_actor_id
    let smart_contract_config_name = plan.smart_contract_config_name
    let smart_contract_type = plan.smart_contract_type
    let smart_contract_address = plan.smart_contract_address


    let wallet_address = economy.kernel_wallet_address(identity_id=provider_identity_id)
    let wallet_public_key = economy.kernel_wallet_public_key(identity_id=provider_identity_id)
    let wallet_private_key_encrypted = economy.kernel_wallet_private_key_encrypted(
        identity_id=provider_identity_id
    )
    input wallet_id from wallet_id default economy.kernel_wallet_id(identity_id=provider_identity_id)

    bind wallet_wallet_id wallet.main
    economy_system call program.port.wallet_wallet_id.projection_node wallet.Wallet.build(
        address=wallet_address,
        public_key=wallet_public_key,
        private_key_encrypted=wallet_private_key_encrypted
    )

    input provider_finance_entity_id from provider_finance_entity_id default economy.stable_finance_entity_id(identity_id=provider_identity_id)

    bind finance_entity_provider_finance_entity_id finance_entity.main
    economy_system call program.port.finance_entity_provider_finance_entity_id.projection_node finance.FinanceEntity.build(
        identity_id=provider_identity_id,
        wallet_id=wallet_id
    )

    input smart_contract_config_id from smart_contract_config_id default economy.stable_smart_contract_config_id(
        name=smart_contract_config_name,
        type=smart_contract_type
    )
    bind smart_contract_config_smart_contract_config_id smart_contract_config.main
    economy_system call program.port.smart_contract_config_smart_contract_config_id.projection_node smart_contract.SmartContractConfig.build(
        name=smart_contract_config_name,
        description="Seeded by kernel ops (aware-kernel)",
        type=smart_contract_type,
        smart_contract_schema={}
    )

    input smart_contract_id from smart_contract_id default economy.stable_smart_contract_id(
        smart_contract_config_id=smart_contract_config_id,
        blockchain_address=smart_contract_address
    )
    bind smart_contract_smart_contract_id smart_contract.main
    economy_system call program.port.smart_contract_smart_contract_id.projection_node smart_contract.SmartContract.build_via_smart_contract_config(
        smart_contract_config_id=smart_contract_config_id,
        blockchain_address=smart_contract_address,
        status=active,
        arguments={}
    )
}
