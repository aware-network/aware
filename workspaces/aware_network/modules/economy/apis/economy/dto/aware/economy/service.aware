    transaction_externals EconomyWalletCapitalTransactionExternalSummary[] = []
    transactions EconomyWalletCapitalTransactionSummary[] = []
    reservations EconomyWalletCapitalReservationSummary[] = []
    escrows EconomyWalletCapitalEscrowSummary[] = []
    settlements EconomyWalletCapitalSettlementSummary[] = []
    provider_lifecycle_receipts EconomyWalletCapitalProviderLifecycleSummary[] = []
    activity_count Int = 0
    info String?
}

