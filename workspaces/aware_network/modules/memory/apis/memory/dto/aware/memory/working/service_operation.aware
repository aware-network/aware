class RecordResolvedEventMeaningRequest augment MemoryWorkingServiceRequest {
    operation String = "record_resolved_event_meaning"
    actor_id UUID?
    memory_working_item_id UUID
    resolved_meaning aware_reactivity_service_dto.reactivity.ReactivityEventMeaningResolutionResult
    resolver_status String
    resolver_endpoint_ref String
    resolver_discriminant String
    resolver_program_impl_instruction_intent_id UUID
    resolver_action_config_id UUID
    resolver_api_capability_endpoint_id UUID
    resolver_api_call_id UUID
    resolver_api_call_key UUID
    resolver_request_model_id UUID
    resolver_api_call_outcome_id UUID
    resolver_response_model_id UUID
    resolver_response_class_config_id UUID
    resolver_service_operation_id UUID
    resolver_service_operation_config_id UUID
    resolver_service_operation_commit_id UUID
    resolver_service_operation_head_commit_id UUID
    resolver_service_operation_branch_id UUID
    resolver_service_operation_projection_hash String
    resolver_api_call_outcome_commit_id UUID
    resolver_api_call_outcome_head_commit_id UUID
    resolver_api_call_outcome_branch_id UUID
    resolver_api_call_outcome_projection_hash String
}

class RecordResolvedEventMeaningResponse augment MemoryWorkingServiceResponse {
    operation String = "record_resolved_event_meaning"
    memory_working working.MemoryWorkingPin?
    item working.MemoryWorkingItemPin?
    resolved_event_meaning working.MemoryResolvedEventMeaningEvidence
    receipt working.MemoryWorkingCommitReceipt?
}

