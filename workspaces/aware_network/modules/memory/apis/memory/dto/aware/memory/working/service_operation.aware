/// Request/response DTOs for Memory Working service operations.
///
/// V0 is intentionally scoped to working memory. Semantic, episodic,
/// procedural search, event subscription, and Actor-Action models are later
/// lanes.

class MemoryWorkingServiceRequest {
    operation String
    request_id UUID?
}

class MemoryWorkingServiceResponse {
    operation String
    request_id UUID?
    success Bool = true
    info String?
    error String?
}

class EnsureMemoryWorkingRequest augment MemoryWorkingServiceRequest {
    operation String = "ensure_memory_working"
    actor_id UUID?
    key String = "default"
}

class EnsureMemoryWorkingResponse augment MemoryWorkingServiceResponse {
    operation String = "ensure_memory_working"
    memory_working working.MemoryWorkingPin
    receipt working.MemoryWorkingCommitReceipt?
}

class DescribeMemoryWorkingRequest augment MemoryWorkingServiceRequest {
    operation String = "describe_memory_working"
    memory_working_id UUID?
    actor_id UUID?
    key String = "default"
}

class DescribeMemoryWorkingResponse augment MemoryWorkingServiceResponse {
    operation String = "describe_memory_working"
    exists Bool = false
    memory_working working.MemoryWorkingPin?
}

class ListMemoryWorkingItemsRequest augment MemoryWorkingServiceRequest {
    operation String = "list_memory_working_items"
    memory_working_id UUID?
    actor_id UUID?
    key String = "default"
    kind String?
    limit Int?
}

class ListMemoryWorkingItemsResponse augment MemoryWorkingServiceResponse {
    operation String = "list_memory_working_items"
    memory_working working.MemoryWorkingPin?
    items working.MemoryWorkingItemPin[] = []
}

class ValidateMemoryWorkingItemRequest augment MemoryWorkingServiceRequest {
    operation String = "validate_memory_working_item"
    memory_working_item_id UUID
    expected_identity_session_id UUID?
    expected_attention_session_id UUID?
    expected_attention_session_section_id UUID?
    expected_focus_scope_id UUID?
    expected_object_instance_graph_commit_id UUID?
    expected_projection_hash String?
    validate_sources Bool = true
}

class ValidateMemoryWorkingItemResponse augment MemoryWorkingServiceResponse {
    operation String = "validate_memory_working_item"
    evidence working.MemoryWorkingItemEvidence?
}

class ResolveMemoryContextRequest augment MemoryWorkingServiceRequest {
    operation String = "resolve_memory_context"
    memory_working_id UUID?
    actor_id UUID?
    key String = "default"
    kind String?
    limit Int?
    expected_identity_session_id UUID?
    expected_attention_session_id UUID?
    expected_attention_session_section_id UUID?
    expected_focus_scope_id UUID?
    expected_object_instance_graph_commit_id UUID?
    expected_projection_hash String?
    validate_sources Bool = true
    include_unusable Bool = true
}

class ResolveMemoryContextResponse augment MemoryWorkingServiceResponse {
    operation String = "resolve_memory_context"
    exists Bool = false
    memory_working working.MemoryWorkingPin?
    items working.MemoryWorkingItemEvidence[] = []
    usable_item_count Int = 0
    unresolved_item_count Int = 0
}

class ResolveActorMemoryContextRequest augment MemoryWorkingServiceRequest {
    operation String = "resolve_actor_memory_context"
    actor_id UUID?
    key String = "default"
    kind String?
    limit Int?
    identity_session_id UUID?
    parent_identity_session_id UUID?
    expected_attention_session_id UUID?
    expected_attention_session_section_id UUID?
    expected_focus_scope_id UUID?
    expected_object_instance_graph_commit_id UUID?
    expected_projection_hash String?
    validate_identity Bool = true
    validate_sources Bool = true
    include_unusable Bool = true
}

class ResolveActorMemoryContextResponse augment MemoryWorkingServiceResponse {
    operation String = "resolve_actor_memory_context"
    actor_context working.MemoryActorContextEvidence
    exists Bool = false
    memory_working working.MemoryWorkingPin?
    items working.MemoryWorkingItemEvidence[] = []
    usable_item_count Int = 0
    unresolved_item_count Int = 0
