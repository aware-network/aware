/// One stable-id row in a complete shared-layout transition intent.
class InterfaceAttentionLayoutTransitionSectionIntent {
    layout_config_section_config_id UUID
    order Int
    weight_micros Int
    is_visible Bool = true
    is_collapsed Bool = false
}

/// Commit one complete renderer-neutral layout vector through Interface Host.
///
/// Pixels, viewport dimensions, and floating geometry are intentionally absent.
class InterfaceApplyAttentionLayoutTransitionRequest augment comms.models.InterfaceControlPlaneRequest {
    operation String = "interface_apply_attention_layout_transition"
    namespace String
    client_intent_id String
    expected_previous_layout_transition_id UUID?
    topology_transition_id UUID?
    section_states comms.models.InterfaceAttentionLayoutTransitionSectionIntent[] = []
}

class InterfaceApplyAttentionLayoutTransitionResponse augment comms.models.InterfaceControlPlaneResponse {
    operation String = "interface_apply_attention_layout_transition"
    namespace String
    outcome String
    conflict_reason String?
    active_layout_transition_id UUID?
    active_topology_transition_id UUID?
    object_instance_graph_commit_id UUID?
    graph_hash_post String?
    host_state comms.models.InterfaceHostState
}

/// One stable admitted config-section anchor in a complete topology intent.
class InterfaceAttentionLayoutTopologyTransitionSectionIntent {
    layout_config_section_config_id UUID
    order Int
}

/// Commit one complete active-membership/order vector through Attention.
class InterfaceApplyAttentionLayoutTopologyTransitionRequest augment comms.models.InterfaceControlPlaneRequest {
