/// Canonical local control-plane DTOs for the Interface daemon.
///
/// This package is local-machine scoped:
/// - not a remote API rail
/// - not graph/ORM SSOT
/// - generated from `.aware` so `services/interface`, textual clients, and
///   future CLI clients share one request/response vocabulary

class InterfaceControlPlaneOperation {
    request comms.models.InterfaceControlPlaneRequest?
    response comms.models.InterfaceControlPlaneResponse?
    notification comms.models.InterfaceControlPlaneNotification?
}

ann comms.models.InterfaceControlPlaneOperation oneof request response notification

class InterfaceControlPlaneRequest {
    operation String
    request_id UUID?
    protocol_version Int = 1
}

class InterfaceControlPlaneResponse {
    operation String
    request_id UUID?
    protocol_version Int = 1
    success Bool = true
    error String?
}

class InterfaceControlPlaneNotification {
    operation String
    notification_id UUID?
    protocol_version Int = 1
}

class PingRequest augment comms.models.InterfaceControlPlaneRequest {
    operation String = "ping"
}

class PingResponse augment comms.models.InterfaceControlPlaneResponse {
    operation String = "ping"
    service String = "aware_interface_service"
    status String = "ok"
    socket_path String?
    daemon_instance_id UUID?
    daemon_started_at String?
    daemon_source_fingerprint String?
    repository_root String?
    state_home String?
    default_endpoint String?
    expected_source_fingerprint String?
    restart_recommended Bool = false
    restart_reason String?
    namespaces comms.models.HostedInterfaceNamespace[] = []
}

