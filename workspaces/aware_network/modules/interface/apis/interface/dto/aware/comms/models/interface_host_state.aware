/// Transport-facing state snapshots exposed by the local Interface daemon.
///
/// These DTOs are not SSOT graph entities. They are local control-plane read
/// models that summarize the live host service state for renderer and CLI clients.

class InterfaceTransportState {
    available Bool
    registered Bool
    authenticated Bool
    actor_id UUID?
    interface_id UUID?
    interface_system_actor_id UUID?
    interface_system_identity_id UUID?
    interface_session_id UUID?
    session_label String?
    capabilities String[] = []
    protocol_version Int?
    last_seen_at String?
    interface_identity_network_node_id UUID?
    interface_session_network_binding_id UUID?
}

