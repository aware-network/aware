    selected_workspace comms.models.InterfaceSelectedWorkspaceState?
    selected_semantic_package comms.models.InterfaceSelectedSemanticPackageState?
    current_screen comms.models.InterfaceCurrentScreen?
    current_operation comms.models.InterfaceOperationState?
    allowed_actions comms.models.InterfaceAllowedAction[] = []
    recovery_capabilities comms.models.InterfaceHostRecoveryCapabilityState[] = []
    warnings String[] = []
}
