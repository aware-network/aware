pane interface_admission {
    kind interface_admission

    view aware_interface.admission.v1 default {
        """Interface Admission state for creating, selecting, pairing, or resuming a canonical Interface."""
    }

    render default {
        view aware_interface.admission.v1;
        version "0.1.0";

        require node_kind scroll;
        require node_kind column;
        require node_kind row;
        require node_kind repeat;
        require node_kind field;
        require node_kind list_item;
        require node_kind status;
        require node_kind button;
        require node_kind receipt;
        require action_binding host_capability;

        node root scroll pane {
            style density = "comfortable";
        }

        node root.header column section;

        node root.header.title text heading {
            text "Enter Aware";
            style emphasis = "primary";
        }

        node root.header.summary text paragraph {
            text "Create, select, pair, or resume a canonical Interface.";
            style tone = "muted";
        }

        node root.status status status {
            bind text from state.status attr status transform text fallback "not_admitted";
            bind tone from state.status_tone attr status_tone transform text fallback "warning";
        }

        node root.host field metadata {
            label "Host";
            bind text from state.host_label attr host_label transform text fallback "Interface Host";
        }

        node root.session field metadata {
            label "Renderer session";
            bind text from state.renderer_session_label attr renderer_session_label transform text fallback "New session";
        }

        node root.current_interface field metadata {
            label "Selected Interface";
            bind text from state.selected_interface_label attr selected_interface_label transform text fallback "No Interface selected";
        }

        node root.actions row section;

        node root.actions.create button action {
            label "Create Interface";
            style emphasis = "primary";
            bind enabled from state.can_create_interface attr can_create_interface transform exists;
        }

        node root.actions.select button action {
            label "Select Interface";
            bind enabled from state.can_select_interface attr can_select_interface transform exists;
        }

        node root.actions.pair button action {
            label "Pair Device";
            bind enabled from state.can_request_pairing attr can_request_pairing transform exists;
        }

        node root.actions.resume button action {
            label "Resume Interface";
            bind enabled from state.can_resume_interface attr can_resume_interface transform exists;
        }

        node root.available_header text heading {
            text "Available Interfaces";
            bind visible from state.available_interfaces attr available_interfaces transform not_empty;
        }

        node root.available repeat section {
            bind items from state.available_interfaces attr available_interfaces transform raw;
        }

        node root.available.row list_item section {
            bind text item.display_name::available_interfaces fallback "Interface";
        }

        node root.pairing receipt receipt {
            style tone = "provenance";
            bind text from state.pairing_challenge attr pairing_challenge transform text;
            bind visible from state.pairing_challenge attr pairing_challenge transform not_empty;
        }

        node root.receipt receipt receipt {
            bind text from state.receipt_message attr receipt_message transform text;
            bind visible from state.receipt_message attr receipt_message transform not_empty;
        }

        node root.error receipt receipt {
            style tone = "warning";
            bind text from state.error attr error transform text;
            bind visible from state.error attr error transform not_empty;
        }
    }
}
