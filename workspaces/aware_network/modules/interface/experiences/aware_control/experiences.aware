    }
}

experience object_projection_graph_identity on aware_meta.graph.projection.ObjectProjectionGraphIdentity {
    node graph.projection.ObjectProjectionGraphIdentity {
        id default
    }
}

experience environment on aware_environment.environment.Environment {
