projection Home is_branchable {
    root home.Home

    home.Home::doors
    home.Home::tvs
    home.Tv::channels
    home.Tv::active_channel

    observable overview {
        """
        Global home state.
        """
    }

    observable security {
        """
        Door and access state.
        """
    }

    observable entertainment {
        """
        Tv and channel state.
        """
    }
}
