ann attention.section.GetAttentionSectionStateResponse::operation discriminate tag "get_attention_section_state"
ann attention.section.ActivateAttentionSectionObservableResponse::operation discriminate tag "activate_attention_section_observable"
ann attention.section.GetAttentionFocusScopeCommitsResponse::operation discriminate tag "get_attention_focus_scope_commits"
ann attention.section.GetAttentionRuntimeMountResponse::operation discriminate tag "get_attention_runtime_mount"
