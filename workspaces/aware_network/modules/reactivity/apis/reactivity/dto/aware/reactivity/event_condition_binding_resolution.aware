/// Canonical DTO for condition-binding resolution used by receipt evaluators.
///
/// Ownership:
/// - Reactivity API owns cross-module binding contracts.
/// - Runtime and node rails consume this DTO as the typed boundary.

class EventConditionBindingResolution {
    id UUID
    event_config_id UUID
    condition_config_id UUID
    is_enabled Bool
    continue_on_fail Bool
    is_required Bool
    /// Optional instance-scope filters loaded from EventConfigConditionConfigScope.
    ///
    /// Contract:
    /// - Empty means the binding keeps existing lane-level behavior.
    /// - Non-empty means the condition evaluator intersects commit trigger
    ///   candidate ids with this set before evaluating class/attribute policy.
    /// - Values are Meta ClassInstanceIdentity ids. This DTO never references
    ///   Experience graph-binding objects.
    scoped_class_instance_identity_ids UUID[] = []
    action_bindings EventActionBinding[]
}
