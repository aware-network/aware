/// Canonical DTO for one reactivity action execution correlation.
///
/// Ownership:
/// - Reactivity API owns lifecycle correlation contracts.
/// - Runtime dispatchers produce this payload.
/// - Action executors consume the correlated context.
/// - Caller attribution lives above this rail in request context or
///   provenance receipts.

class ActionExecution {
    action_execution_id UUID?
    action_intent_id UUID
    event_id UUID
    event_type String
    source String
    branch_id UUID
    projection_hash String
    commit_id UUID
    event_config_condition_config_id UUID?
    action_binding_id UUID?
    action_config_id UUID?
    action_type String?
    root_object_id UUID?
    object_instance_graph_id UUID?
    graph_hash_post String?
    execution_key String = "primary"
    status ActionExecutionStatus = created
    execution_context JsonValue?
    /// API receipt correlated to this execution attempt.
    ///
    /// This is an evidence link to the API-owned ingress receipt. The request
    /// value itself lives once on `ApiCall.request_model`.
    api_call_id UUID?
    executor_ref String?
    result_info String?
}

/// Claim one canonical execution attempt before crossing a provider boundary.
class ReactivityActionExecutionClaimRequest {
    request_id UUID?
    claimant_id String
    intent ReactivityActionIntent
    execution_key String = "primary"
    execution_context JsonObject = {}
}

/// Graph-backed claim result. Only `claimed` grants provider invocation.
class ReactivityActionExecutionClaimResponse {
    request_id UUID?
    accepted Bool = false
    claim_status ActionExecutionClaimStatus?
    action_execution ActionExecution?
    event_commit_id UUID?
    action_intent_commit_id UUID?
    action_execution_commit_id UUID?
    info String?
    error String?
}
