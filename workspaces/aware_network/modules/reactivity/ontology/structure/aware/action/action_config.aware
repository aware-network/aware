class ActionConfig {
    // Relationships
    api_capability_endpoint aware_api.api.ApiCapabilityEndpoint

    // Attributes
    /// Deprecated compatibility schema mirror.
    ///
    /// Schema authority belongs to Meta ClassConfig and API endpoint
    /// request/response/stream contracts. New action rail code must resolve
    /// typed contracts through Experience bindings and `InlineValueInstance`
    /// payload evidence, not this JSON attribute.
    action_schema JsonObject = {}
    action_type String
    allowed_roles String[]
    description String
    is_enabled Bool = true
    is_system Bool = false
    name String key
    require_authentication Bool = true

    fn create construct (
        name String key,
        description String,
        api_capability_endpoint_id UUID,
        action_type String,
        is_enabled Bool = true,
        is_system Bool = false,
        require_authentication Bool = true,
        allowed_roles String[] = [],
        action_schema JsonObject = {}
    ) -> ActionConfig {
        """
        Create a canonical action policy root.

        Contract:
        - `api_capability_endpoint` is the required 1:1 API contract anchor
          for this action. Experience may activate/refine this contract by
          scenario or role, but must not redirect it to another endpoint.
        - `action_schema` is deprecated compatibility metadata only.
        - Request value truth is created once at `ApiCall.request_model`;
          Reactivity carries decision/lifecycle evidence only.
        """
    }
}

ann action.ActionConfig::api_capability_endpoint load eager
