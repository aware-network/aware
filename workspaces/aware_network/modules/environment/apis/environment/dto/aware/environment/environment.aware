/// Commit one EnvironmentSession-owned portal to an existing AttentionSession.
class MountEnvironmentSessionAttentionRequest augment environment.EnvironmentOperationRequest {
    operation String = "mount_environment_session_attention"
    request_id UUID?
    environment_session_id UUID
    attention_session_id UUID
    key String?
