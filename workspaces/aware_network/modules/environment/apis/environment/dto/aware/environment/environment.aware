/// Environment-owned resolution over session Thread/Layout pins into Attention.
///
/// Contract:
/// - Environment validates the EnvironmentSession/NavigationContext/SessionThread
///   scope through Environment-owned state.
/// - AttentionSession and AttentionFocusTransition structure is validated by
///   the Attention service surface, not by reading Attention ontology internals.
/// - This is a read/validation receipt, not a persisted frame model.
class ResolveEnvironmentSessionAttentionRequest augment environment.EnvironmentOperationRequest {
    operation String = "resolve_environment_session_attention"
    request_id UUID?
    environment_session_id UUID
    environment_navigation_context_id UUID?
    environment_session_thread_id UUID?
    environment_session_attention_session_id UUID?
    expected_attention_session_id UUID?
    attention_focus_transition_id UUID?
    expected_attention_session_section_id UUID?
    expected_focus_scope_id UUID?
    expected_object_instance_graph_commit_id UUID?
    expected_projection_hash String?
    include_attention_session Bool = true
    include_transition_list Bool = false
    transition_limit Int?
    metadata JsonObject = {}
}

class EnvironmentSessionAttentionResolution {
    environment_session_id UUID
    environment_navigation_context_id UUID?
    environment_session_thread_id UUID?
    environment_session_attention_session_id UUID?
    environment_id UUID
    environment_profile_id UUID?
    thread_id UUID?
    thread_layout_id UUID?
    attention_session_id UUID?
    identity_session_id UUID?
    attention_session aware_attention_service_dto.attention.session.AttentionSessionPin?
    active_transition aware_attention_service_dto.attention.session.AttentionFocusTransitionPin?
    validation aware_attention_service_dto.attention.session.AttentionTransitionValidationResult?
    transitions aware_attention_service_dto.attention.session.AttentionFocusTransitionPin[] = []
    status String = "resolved"
    blockers String[] = []
    evidence JsonObject = {}
}

