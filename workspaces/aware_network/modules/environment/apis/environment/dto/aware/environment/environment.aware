/// Canonical lane head receipt notification.
///
/// The lane key is `(branch_id, projection_hash)`; receivers must not guess
/// `branch_id` from env/thread.
class LaneCommitReceiptNotification augment environment.EnvironmentOperationNotification {
    operation String = "lane_commit_receipt"
    commit_id UUID
    /// Canonical Meta ObjectInstanceGraphCommit id for this domain commit.
    ///
    /// This is the direct provenance ref consumers use when they need the
    /// durable OIG commit identity instead of only the domain commit id.
    object_instance_graph_commit_id UUID?
    /// ObjectProjectionGraph that owns the committed ObjectInstanceGraph when
    /// Environment/Meta topology resolution has enriched the receipt.
    object_projection_graph_id UUID?
    /// ObjectProjectionGraphIdentity anchor for Attention focus targets.
    ///
    /// Optional at the raw commit-store edge; Environment topology/fanout should
    /// populate it when resolving OIGI/OPG identity for focus attachment.
    object_projection_graph_identity_id UUID?
    /// ObjectInstanceGraph snapshot identity for the committed lane head.
    object_instance_graph_id UUID?
    /// ObjectInstanceGraphIdentity worldline anchor for the committed lane head.
    object_instance_graph_identity_id UUID?
    /// ObjectInstanceGraphBranch anchor for `(object_instance_graph_identity_id, branch_id)`.
    ///
    /// This is the concrete materialized focus target id that Attention can use
    /// without subscribing to Meta directly.
    object_instance_graph_branch_id UUID?
    /// Canonical commit creation timestamp (unix ms) when emitted by commit store.
    ///
    /// Optional for backward-compatible transports; receivers should fall back to
    /// observed-at timestamps when absent.
    created_at_unix_ms Int?
    /// Canonical label for the operation that produced this commit (when known).
    ///
    /// This must be emitted by runtime/commit-store writers; UI must not guess.
    operation_label String?
    /// Optional function-call origin (when this commit was produced by invoke_function).
    call_target InvokeFunctionCallTarget?
    function_id UUID?
    object_id UUID?
    /// Canonical class-instance identity attribution for this commit when known.
    ///
    /// Runtime owns this value and must emit deterministic identity truth.
    class_instance_identity_id UUID?
    graph_hash_post String?
    root_object_id UUID?
    head_version Int?
}

/// Canonical reactivity event receipt notification derived from lane commits.
///
/// Contract:
/// - Emitted by runtime receipt environments after condition evaluation.
/// - Deterministic per `(event_id, commit_id)` and safe for at-least-once transport.
class LaneEventReceiptNotification augment environment.EnvironmentOperationNotification {
    operation String = "lane_event_receipt"
    event_id UUID
    event_type String
    source String
    created_at_unix_ms Int
    commit_id UUID
    target_actor_id UUID?
    actor_subscription_id UUID?
    event_config_condition_config_id UUID?
    graph_hash_post String?
    object_instance_graph_id UUID?
    root_object_id UUID?
}

/// Canonical action execution receipt notification derived from a reactivity event.
///
