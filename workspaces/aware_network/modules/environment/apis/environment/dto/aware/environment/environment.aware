/// Canonical environment operation DTOs (transport-layer, graph/ORM agnostic).
///
/// SSOT: `environment-service-dto` generated from `apis/environment/dto`.
///
/// `aware_comms` re-exports these DTOs for transport/service import stability,
/// but schema ownership remains here so all language targets compile from one rail.

class EnvironmentOperationContext {
    // Attributes
    actor_id UUID?
    environment_id UUID
    process_id UUID?
    thread_id UUID?
    branch_id UUID?
    projection_hash String?
}

/// Context for environment notifications (fan-out).
///
/// Notifications may be emitted by commit stores and transport layers that do not
/// have a full EnvironmentOperationContext. The lane key is still canonical.
class EnvironmentOperationNotificationContext {
    // Attributes
    actor_id UUID?
    environment_id UUID?
    process_id UUID?
    thread_id UUID?
    branch_id UUID
    projection_hash String
}

/// EnvironmentOperation is either a request or a response.
class EnvironmentOperation {
    request EnvironmentOperationRequest?
    response EnvironmentOperationResponse?
    notification EnvironmentOperationNotification?
}

// Envelope XOR constraints (SSOT via annotations; no name-based inference in renderers).
ann environment.EnvironmentOperation oneof request response notification

/// Request union base (operation + context).
class EnvironmentOperationRequest augment environment.EnvironmentOperationContext {
    operation String
}

/// Response union base (operation + context).
class EnvironmentOperationResponse augment environment.EnvironmentOperationContext {
    operation String
}

/// Notification union base (operation + context).
///
/// Used for commit receipts / lane head moves so clients can sync lanes without
/// inferring from unrelated transports (e.g., inference streams).
class EnvironmentOperationNotification augment environment.EnvironmentOperationNotificationContext {
    operation String
}

enum InvokeFunctionCallTarget {
    instance
    opg_constructor
}

class FetchCapabilitiesRequest augment environment.EnvironmentOperationRequest {
    operation String = "fetch_capabilities"
}

/// Describe the hosted EnvironmentConfig (template/map) for this ENVIRONMENT service.
///
/// This does NOT describe a provisioned environment instance (territory). Use
/// `DescribeEnvironmentRequest` for the territory instance.
class DescribeEnvironmentConfigRequest augment environment.EnvironmentOperationRequest {
    operation String = "describe_environment_config"
}

/// Describe a provisioned Environment instance (territory) and its boot/lane pointers.
class DescribeEnvironmentRequest augment environment.EnvironmentOperationRequest {
    operation String = "describe_environment"
}

/// Describe the provisioned environment OS topology (Process/Thread) and the
/// attached domain lanes per thread (ThreadObjectInstanceGraphBranch).
///
/// Purpose:
/// - Deterministic lane discovery for agents/CLIs (no guessing from UI titles).
/// - Interface-parity bootstrap for (process_key, thread_key) -> lane list.
class DescribeEnvironmentTopologyRequest augment environment.EnvironmentOperationRequest {
    operation String = "describe_environment_topology"
    /// Optional filter by canonical Process key (stable-id input).
    process_key String?
    /// Optional filter by canonical Thread key (stable-id input).
    thread_key String?
}

/// Describe canonical environment status envelope for local/remote parity.
///
/// Contract:
/// - One payload shape for both local and remote providers.
/// - Blocks must declare authority kind explicitly.
/// - `strict_commit_truth=true` refuses when commit truth cannot be resolved.
class DescribeEnvironmentStatusRequest augment environment.EnvironmentOperationRequest {
    operation String = "describe_environment_status"
    /// Optional block filter (`environment_interface`, `local_workspace`, `issue`, `runtime`, `commit_truth`).
    include_blocks String[] = []
    /// When true, missing commit-truth authority is a refusal.
    strict_commit_truth Bool = false
}

class EnsureReadyRequest augment environment.EnvironmentOperationRequest {
    operation String = "ensure_ready"
}

class GetLaneHeadRequest augment environment.EnvironmentOperationRequest {
    operation String = "get_lane_head"
}

class GetObjectInstanceGraphCommitRequest augment environment.EnvironmentOperationRequest {
    operation String = "get_object_instance_graph_commit"
    commit_id UUID
}

/// Materialize one committed projection root as an ontology DTO snapshot.
///
/// V0 verifier contract:
/// - Caller must provide an explicit `(branch_id, projection_hash, commit_id)`.
/// - Runtime must not resolve DTO classes from caller paths or repo-local imports.
/// - Runtime may return `dto_runtime_artifact_unavailable` until the deploy
///   contract declares a pinned DTO artifact/package closure for the requested
///   DTO target.
class MaterializeCommittedProjectionDtoRequest augment environment.EnvironmentOperationRequest {
    operation String = "materialize_committed_projection_dto"
    commit_id UUID
    expected_graph_hash_post String?
    object_instance_graph_id UUID?
    root_object_id UUID?
    use_commit_root Bool = true
    dto_class_ref String?
    class_config_id UUID?
    dto_package_name String?
    dto_import_root String?
    view_ref String?
    projection_view_key String?
    include_relationships Bool = true
    max_depth Int?
}

class ResolveRuntimeFunctionTargetQuery {
    query_key String?
    function_ref String
    call_target InvokeFunctionCallTarget = instance
    projection_hash_hint String?
}

class ResolveRuntimeClassRefQuery {
    query_key String?
    class_ref String
}

class ResolveRuntimeRefsRequest augment environment.EnvironmentOperationRequest {
    operation String = "resolve_runtime_refs"
    function_targets ResolveRuntimeFunctionTargetQuery[] = []
    class_refs ResolveRuntimeClassRefQuery[] = []
}

/// Install live service-to-service API dependency routes into this Environment.
///
/// Node sends this after it binds selected ServicePackage required/provided
/// ApiPackage truth to concrete provider ServiceHost endpoints. The payload
/// uses the shared route descriptor JSON contract; Environment must not infer
/// providers from source manifests.
class ConfigureServiceApiDependencyRoutesRequest augment environment.EnvironmentOperationRequest {
    operation String = "configure_service_api_dependency_routes"
    routes JsonArray = []
}

/// Admit an actor to a concrete EnvironmentProfile using Identity-owned ActorConfig
/// eligibility.
///
/// Contract:
/// - Environment owns the admission scope and EnvironmentProfile -> ActorConfig
///   eligibility check.
/// - Identity owns concrete RoleAssignment/ActorRole truth.
/// - This operation grants no Experience access and does not infer Experience
///   participation.
class AdmitEnvironmentActorRequest augment environment.EnvironmentOperationRequest {
    operation String = "admit_actor"
    request_id UUID?
    environment_profile_id UUID
    actor_config_id UUID
    class_instance_identity_id UUID
    object_instance_graph_branch_key String = "all"
    object_instance_graph_branch_id UUID?
    requested_role_config_ids UUID[] = []
    requested_role_config_names String[] = []
    reason String?
    evidence JsonObject = {}
}

class InvokeFunctionRequest augment environment.EnvironmentOperationRequest {
    operation String = "invoke_function"
    /// Lane addressing (canonical):
    /// - `branch_id` (in EnvironmentOperationContext) is REQUIRED for `call_target=instance`.
    /// - `branch_id` MAY be omitted for `call_target=opg_constructor` (runtime allocates and returns it).
    ///
    /// The lane key is `(branch_id, projection_hash)`; runtime must not guess `branch_id` from env/thread.
    call_target InvokeFunctionCallTarget = instance
    object_id UUID?
    object_projection_graph_id UUID?
    /// Resolved ObjectProjectionGraphIdentity for this call target when known.
    ///
    /// Environment does not need this to invoke Meta, but consumers such as
    /// Attention need it to bind committed focus to the same projection identity
    /// without subscribing to Meta directly.
    object_projection_graph_identity_id UUID?
    function_id UUID
    args JsonArray = []
    kwargs JsonObject = {}
    expected_graph_hash_pre String?
    expected_head_commit_id UUID?
    commit Bool = true
    publish Bool = false
}

class CapabilityArgument {
    id UUID
    name String
    direction String?
    type String?
    required Bool = true
    default JsonValue?
    enum JsonArray?
    description String?
}

class CapabilityFunction {
    id UUID
    name String
    summary String?
    role_id UUID?
    is_constructor Bool = false
    inputs CapabilityArgument[]
    outputs CapabilityArgument[]
    arguments CapabilityArgument[]
}

class CapabilityRole {
    id UUID
    name String
    description String?
    metadata JsonObject = {}
    functions CapabilityFunction[]
}

class CapabilityObject {
    id UUID
    name String
    description String?
    functions CapabilityFunction[]
}

class FetchCapabilitiesResponse augment environment.EnvironmentOperationResponse {
    operation String = "fetch_capabilities"
    roles CapabilityRole[]
    functions CapabilityFunction[]
    objects CapabilityObject[]
}

class ResolvedRuntimeFunctionTarget {
    query_key String?
    status String
    error String?
    function_ref String
    call_target InvokeFunctionCallTarget = instance
    class_config_id UUID?
    class_name String?
    class_fqn String?
    class_config_function_config_id UUID?
    function_id UUID?
    function_name String?
    projection_hash String?
    object_projection_graph_id UUID?
    object_projection_graph_identity_id UUID?
    candidate_projection_hashes String[] = []
    evidence JsonObject = {}
}

class ResolvedRuntimeClassRef {
    query_key String?
    status String
    error String?
    class_ref String
    class_config_id UUID?
    class_name String?
    class_fqn String?
    evidence JsonObject = {}
}

class ResolveRuntimeRefsResponse augment environment.EnvironmentOperationResponse {
    operation String = "resolve_runtime_refs"
    status String
    error String?
    function_targets ResolvedRuntimeFunctionTarget[] = []
    class_refs ResolvedRuntimeClassRef[] = []
    evidence JsonObject = {}
}

class ConfigureServiceApiDependencyRoutesResponse augment environment.EnvironmentOperationResponse {
    operation String = "configure_service_api_dependency_routes"
    status String = "succeeded"
    error String?
    route_count Int = 0
    route_consumers_started Bool = false
}

/// Environment-owned membership pointer to one Ontology authority.
///
/// Contract:
/// - This is not an OIG/OIGI inventory view.
/// - OIGI discovery remains behind the linked Ontology authority.
/// - Commit fields are mutation/read receipts for the Environment lane only.
class EnvironmentOntologyMembership {
    environment_ontology_id UUID?
    ontology_id UUID
    role String = "runtime"
    status String = "active"
    title String?
    description String?
    commit_id UUID?
    graph_hash_post String?
    evidence JsonObject = {}
}

/// Attach one Ontology authority to an existing stable Environment.
///
/// Contract:
/// - Mutates `Environment.ontologies` through the Environment projection lane.
/// - Service implementation must route the mutation through Ontology graph
///   authority; no service-local registry is allowed.
/// - Does not accept or persist OIG/OIGI membership or OIG commit pins.
class AttachEnvironmentOntologyRequest augment environment.EnvironmentOperationRequest {
    operation String = "attach_environment_ontology"
    ontology_id UUID
    role String = "runtime"
    status String = "active"
    title String?
    description String?
    expected_graph_hash_pre String?
    expected_head_commit_id UUID?
    commit Bool = true
    publish Bool = false
}

class AttachEnvironmentOntologyResponse augment environment.EnvironmentOperationResponse {
    operation String = "attach_environment_ontology"
    status String
    error String?
    membership EnvironmentOntologyMembership?
    commit_id UUID?
    object_instance_graph_commit_id UUID?
    graph_hash_pre String?
    graph_hash_post String?
    evidence JsonObject = {}
}

/// Resolve and register an Ontology-owned runtime artifact set for this running
/// Environment.
///
/// Contract:
/// - This does not create Environment/Ontology membership. Use
///   `attach_environment_ontology` for commit truth first.
/// - Runtime artifacts are resolved through Ontology service authority.
/// - Environment owns only an activation/availability registry over returned
///   artifact-set descriptors; Ontology remains artifact provenance authority.
class EnsureEnvironmentOntologyRuntimeRequest augment environment.EnvironmentOperationRequest {
    operation String = "ensure_environment_ontology_runtime"
    ontology_id UUID?
    package_name String?
    fqn_prefix String?
    artifact_set_id String?
    workspace_revision_id String?
    materialization_ref String?
    include_artifacts Bool = true
    source_payload JsonObject?
    membership_commit_id UUID?
}

class EnsureEnvironmentOntologyRuntimeResponse augment environment.EnvironmentOperationResponse {
    operation String = "ensure_environment_ontology_runtime"
    status String
    error String?
    ontology_id UUID?
    package_name String?
    fqn_prefix String?
    artifact_set_id String?
    runtime_projection_descriptor_count Int = 0
    capability_object_count Int = 0
    capability_function_count Int = 0
    registered_artifact_ref_count Int = 0
    registry_artifact_ref_count Int = 0
    membership_commit_id UUID?
    evidence JsonObject = {}
}

/// List Environment-owned Ontology memberships from a committed Environment DTO.
///
/// Contract:
/// - Returns only `EnvironmentOntology` membership pointers.
/// - Does not expand Ontology-owned OIGI inventory.
class ListEnvironmentOntologiesRequest augment environment.EnvironmentOperationRequest {
    operation String = "list_environment_ontologies"
    commit_id UUID?
    root_object_id UUID?
    expected_graph_hash_post String?
    dto_class_ref String? = "aware_environment_ontology_dto.environment.environment.Environment"
    dto_package_name String? = "environment-ontology-dto"
    dto_import_root String? = "aware_environment_ontology_dto"
}

class ListEnvironmentOntologiesResponse augment environment.EnvironmentOperationResponse {
    operation String = "list_environment_ontologies"
    status String
    error String?
    memberships EnvironmentOntologyMembership[] = []
    commit_id UUID?
    object_instance_graph_commit_id UUID?
    graph_hash_post String?
    evidence JsonObject = {}
}

