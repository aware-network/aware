/// Projection-host placement inside one ThreadConfig LayoutConfig option.
///
/// Contract:
/// - Attention owns layout section config.
/// - Meta owns ObjectProjectionGraph authority.
/// - Experience may later bind views/actions over these declared host slots.
class ThreadConfigLayoutConfigSection {
    // Relationships
    layout_config_section_config aware_attention.layout.LayoutConfigSectionConfig key
    object_projection_graph aware_meta.graph.projection.ObjectProjectionGraph?

    // Attributes
    /// Optional stable association key under the parent ThreadConfigLayoutConfig.
    key String?
    /// Ordering hint within repeated section placements.
    position Int? = null
    /// Marks the preferred/default placement for this layout section.
    is_default Bool = false
    /// Narrative text for why this projection belongs in the section.
    narrative String?
    /// Short canonical intent for the section placement.
    intent String?

    fn create construct (
        layout_config_section_config_id UUID key,
        object_projection_graph_id UUID? = null,
        key String? = null,
        position Int? = null,
        is_default Bool = false,
        narrative String? = null,
        intent String? = null
    ) -> ThreadConfigLayoutConfigSection {
        """
        Create a deterministic ThreadConfigLayoutConfigSection edge.

        Contract:
        - Identity is scoped under ThreadConfigLayoutConfig by layout section config.
        - Optional OPG ref must point at a hosted projection graph for the same thread config.
        - No Experience-owned graph binding appears in this Environment topology object.
        """
    }
}

ann thread.ThreadConfigLayoutConfigSection::layout_config_section_config load eager
ann thread.ThreadConfigLayoutConfigSection::object_projection_graph load eager
