class EnvironmentConfigPackageOntologyPackage {
    // Relationships
    ontology_package aware_ontology.ontology.OntologyPackage?
    ontology_package_object_instance_graph_commit aware_meta.graph.instance.ObjectInstanceGraphCommit?

    // Attributes
    fqn_prefix String key
    name String key

    fn build construct(
        name String key,
        fqn_prefix String key,
        ontology_package_object_instance_graph_commit_id UUID? = null,
    ) -> EnvironmentConfigPackageOntologyPackage {
        """
        Create a deterministic environment-owned membership edge to one
        Ontology-owned `OntologyPackage`.

        Contract:
        - Parent `EnvironmentConfigPackage` scope is injected by propagation.
        - Target package identity is resolved from `(name, fqn_prefix)`.
        - `ontology_package_object_instance_graph_commit_id` pins the exact
          OntologyPackage semantic package commit when available.
        - Raw OCG package refs are reached through
          `OntologyPackage.object_config_graph_package`, not duplicated here.
        """
    }
}

ann environment.EnvironmentConfigPackageOntologyPackage::ontology_package load eager
ann environment.EnvironmentConfigPackageOntologyPackage::ontology_package_object_instance_graph_commit load eager
