/// SDK operation to API view endpoint bridge.
///
/// This binds an SDK operation endpoint to the API-owned view action that exposes
/// it. The API remains the source of endpoint and action-key truth.
class SdkOperationApiViewCapabilityEndpoint {
    // Relationships
    sdk_operation_api_capability_endpoint SdkOperationApiCapabilityEndpoint key
    api_view aware_api.api.ApiView key
    api_view_capability_endpoint aware_api.api.ApiViewCapabilityEndpoint key

    // Attributes
    api_view_ref String
    action_key String
    endpoint_ref String

    fn create construct (
        sdk_operation_api_capability_endpoint_id UUID key,
        api_view_id UUID key,
        api_view_capability_endpoint_id UUID key,
        api_view_ref String,
        action_key String,
        endpoint_ref String
    ) -> SdkOperationApiViewCapabilityEndpoint {
        """
        Create one deterministic SDK operation binding to one API view endpoint.

        Contract:
        - `sdk_operation_api_capability_endpoint_id` points at the SDK-owned
          operation endpoint row.
        - `api_view_capability_endpoint_id` points at API-owned view action
          truth.
        - `api_view_ref`, `action_key`, and `endpoint_ref` are copied from API
          view capability endpoint resolution for runtime consumers.
        """
    }
}

ann sdk.SdkOperationApiViewCapabilityEndpoint::sdk_operation_api_capability_endpoint load eager
ann sdk.SdkOperationApiViewCapabilityEndpoint::api_view load eager
ann sdk.SdkOperationApiViewCapabilityEndpoint::api_view_capability_endpoint load eager
