/// Declarative port-to-section placement mapping for bind-time adaptation.
class ProgramConfigLayoutPortSection {
    // Relationships
    program_config_port ProgramConfigPort key
    layout_section aware_attention.layout.LayoutSection key

    // Attributes
    on_bind ProgramSlotOnBind = replace
    is_visible_default Bool? = null

    fn build construct (
        program_config_port_id UUID key,
        layout_section_id UUID key,
        on_bind ProgramSlotOnBind = replace,
        is_visible_default Bool? = null
    ) -> ProgramConfigLayoutPortSection {
        """
        Create a deterministic ProgramConfigLayoutPortSection under a ProgramConfigLayout.
        """
    }
}
