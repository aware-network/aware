/// Canonical request/response DTOs for the Experience section-graph-binding service boundary.
///
/// These are transport-level DTOs over Experience-owned section-graph-binding semantics.
/// They do not replace ontology truth and they do not authorize direct Attention mutation.

class ExperienceSectionGraphBindingServiceRequest {
    operation String
    request_id UUID?
}

class ExperienceSectionGraphBindingServiceResponse {
    operation String
    request_id UUID?
    success Bool = true
    info String?
    error String?
    state section_graph_binding.ExperienceSectionGraphBindingState?
    snapshot section_graph_binding.ExperienceSectionGraphBindingStateSnapshot?
}

class GetExperienceSectionGraphBindingCatalogRequest augment section_graph_binding.ExperienceSectionGraphBindingServiceRequest {
    operation String = "get_experience_section_graph_binding_catalog"
    experience_name String
    section_keys String[] = []
    binding_keys String[] = []
}

class GetExperienceSectionGraphBindingCatalogResponse augment section_graph_binding.ExperienceSectionGraphBindingServiceResponse {
    operation String = "get_experience_section_graph_binding_catalog"
    experience_name String
    catalog_revision String?
    bindings section_graph_binding.ExperienceSectionGraphBindingDescriptor[] = []
}

