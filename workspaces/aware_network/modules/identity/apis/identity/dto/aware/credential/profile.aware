/// Public DTOs for Identity-owned credential profile setup.
///
/// Contract:
/// - Credential profiles belong to Identity; organizations are Identity records.
/// - Secret material is never carried in these DTOs.
/// - Secret values live in external resolvers and are referenced only by metadata.

class CredentialProfileSetupRequest {
    identity_id UUID
    profile_key String
    target_kind String = "aware_api"
    credential_kind String = "api_key"
    status String = "planned"
    display_name String?
    target_name String?
    issuer String?
    audience String?
    external_subject String?
    created_at_utc String?
    updated_at_utc String?
    expires_at_utc String?
    metadata JsonObject?

    secret_ref_key String
    resolver_kind String = "env_var"
    secret_name String
    locator String?
    username_hint String?
    material_hint String?
    fingerprint_sha256 String?
    secret_created_at_utc String?
    secret_rotated_at_utc String?
    secret_metadata JsonObject?

    request_id UUID?
    source String?
}

class CredentialProfileSetupReceipt {
    request_id UUID?
    identity_id UUID
    credential_profile_id UUID
    secret_material_ref_id UUID
    profile_key String
    target_kind String
    secret_ref_key String
    resolver_kind String
    secret_name String
    raw_secret_stored Bool = false
    info String?
}

class CredentialReadinessCheckRequest {
    identity_id UUID
    credential_profile_id UUID?
    profile_key String?
    target_kind String = "aware_api"
    receipt_key String?
    resolver_kind String = "env_var"
    secret_ref_key String
    secret_name String?
    checked_at_utc String?
    require_non_empty Bool = true
    details JsonObject?
    request_id UUID?
    source String?
}

class CredentialReadinessCheckReceipt {
    request_id UUID?
    identity_id UUID
    credential_profile_id UUID
    readiness_receipt_id UUID
    profile_key String?
    target_kind String?
    receipt_key String
    status String
    available Bool = false
    resolver_kind String
    secret_ref_key String
    secret_name String?
    checked_at_utc String?
    missing_requirements String[] = []
    credential_handle JsonObject?
    raw_secret_returned Bool = false
    info String?
}
