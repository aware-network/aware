/// Readiness check result for one credential profile.
///
/// Contract:
/// - Records whether a resolver can locate usable material.
/// - Does not include the secret value or one-time token text.
class CredentialReadinessReceipt {
    // Attributes
    receipt_key String key
    status CredentialReadinessStatus
    checked_at_utc String?
    resolver_kind CredentialSecretResolverKind?
    secret_ref_key String?
    missing_requirements String[] = []
    details JsonObject?
    error String?

    fn create construct(
        receipt_key String key,
        status CredentialReadinessStatus,
        checked_at_utc String? = null,
        resolver_kind CredentialSecretResolverKind? = null,
        secret_ref_key String? = null,
        missing_requirements String[] = [],
        details JsonObject? = null,
        error String? = null
    ) -> CredentialReadinessReceipt {
        """
        Create one credential readiness receipt without exposing secret material.
        """
    }
}
