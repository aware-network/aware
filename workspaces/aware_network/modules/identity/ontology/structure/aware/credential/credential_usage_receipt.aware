/// Usage receipt for one credential profile.
///
/// Contract:
/// - Records credential use for API calls, publication, deployment, or service
///   operations.
/// - Stores operation receipts and target refs, never the resolved secret.
class CredentialUsageReceipt {
    // Attributes
    receipt_key String key
    status CredentialUsageStatus
    operation String
    used_at_utc String?
    target_ref String?
    secret_ref_key String?
    request_ref String?
    receipt JsonObject?
    error String?

    fn create construct(
        receipt_key String key,
        status CredentialUsageStatus,
        operation String,
        used_at_utc String? = null,
        target_ref String? = null,
        secret_ref_key String? = null,
        request_ref String? = null,
        receipt JsonObject? = null,
        error String? = null
    ) -> CredentialUsageReceipt {
        """
        Create one credential usage receipt without exposing secret material.
        """
    }
}
