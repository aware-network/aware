/// Identity-owned credential authority for API keys, publish credentials, and
/// external auth rails.
///
/// Contract:
/// - This is the public credential/API key model for Identity.
/// - Secret material is represented only through CredentialSecretMaterialRef.
/// - A profile is contained by Identity; organizations are Identity instances.
/// - Parent identity context is propagated by construct traversal.
class CredentialProfile {
    // Relationships
    secret_material_refs CredentialSecretMaterialRef[]
    grants CredentialGrant[]
    readiness_receipts CredentialReadinessReceipt[]
    usage_receipts CredentialUsageReceipt[]

    // Attributes
    profile_key String key
    target_kind CredentialTargetKind key = aware_api
    credential_kind CredentialKind = api_key
    status CredentialProfileStatus = planned
    display_name String?
    target_name String?
    issuer String?
    audience String?
    external_subject String?
    created_at_utc String?
    updated_at_utc String?
    expires_at_utc String?
    revoked_at_utc String?
    metadata JsonObject?

    fn create construct(
        profile_key String key,
        target_kind CredentialTargetKind key = aware_api,
        credential_kind CredentialKind = api_key,
        status CredentialProfileStatus = planned,
        display_name String? = null,
        target_name String? = null,
        issuer String? = null,
        audience String? = null,
        external_subject String? = null,
        created_at_utc String? = null,
        updated_at_utc String? = null,
        expires_at_utc String? = null,
        revoked_at_utc String? = null,
        metadata JsonObject? = null
    ) -> CredentialProfile {
        """
        Create one credential profile without storing secret material.

        Contract:
        - Parent Identity context is injected by construct propagation.
        - Stable identity is derived from parent Identity plus profile keys.
        - Organization credentials use parent Identity with type=organization.
        """
    }

    fn attach_secret_material_ref(
        secret_ref_key String key,
        resolver_kind CredentialSecretResolverKind key,
        secret_name String,
        locator String? = null,
        username_hint String? = null,
        material_hint String? = null,
        fingerprint_sha256 String? = null,
        created_at_utc String? = null,
        rotated_at_utc String? = null,
        metadata JsonObject? = null
    ) -> CredentialSecretMaterialRef {
        """
        Attach one external secret material reference to this profile.
        """
        let created = construct secret_material_refs.create(
            secret_ref_key = secret_ref_key,
            resolver_kind = resolver_kind,
            secret_name = secret_name,
            locator = locator,
            username_hint = username_hint,
            material_hint = material_hint,
            fingerprint_sha256 = fingerprint_sha256,
            created_at_utc = created_at_utc,
            rotated_at_utc = rotated_at_utc,
            metadata = metadata,
        )
    }

    fn grant_scope(
        grant_key String key,
        scope_kind String key,
        scope_value String key,
        effect CredentialGrantEffect = allow,
        operation String? = null,
        resource_ref String? = null,
        expires_at_utc String? = null,
        metadata JsonObject? = null
    ) -> CredentialGrant {
        """
        Attach one canonical scope/capability grant to this profile.
        """
        let created = construct grants.create(
            grant_key = grant_key,
            scope_kind = scope_kind,
            scope_value = scope_value,
            effect = effect,
            operation = operation,
            resource_ref = resource_ref,
            expires_at_utc = expires_at_utc,
            metadata = metadata,
        )
    }

    fn record_readiness(
        receipt_key String key,
        status CredentialReadinessStatus,
        checked_at_utc String? = null,
        resolver_kind CredentialSecretResolverKind? = null,
        secret_ref_key String? = null,
        missing_requirements String[] = [],
        details JsonObject? = null,
        error String? = null
    ) -> CredentialReadinessReceipt {
        """
        Attach one resolver/readiness receipt to this profile.
        """
        let created = construct readiness_receipts.create(
            receipt_key = receipt_key,
            status = status,
            checked_at_utc = checked_at_utc,
            resolver_kind = resolver_kind,
            secret_ref_key = secret_ref_key,
            missing_requirements = missing_requirements,
            details = details,
            error = error,
        )
    }

    fn record_usage(
        receipt_key String key,
        status CredentialUsageStatus,
        operation String,
        used_at_utc String? = null,
        target_ref String? = null,
        secret_ref_key String? = null,
        request_ref String? = null,
        receipt JsonObject? = null,
        error String? = null
    ) -> CredentialUsageReceipt {
        """
        Attach one credential usage receipt to this profile.
        """
        let created = construct usage_receipts.create(
            receipt_key = receipt_key,
            status = status,
            operation = operation,
            used_at_utc = used_at_utc,
            target_ref = target_ref,
            secret_ref_key = secret_ref_key,
            request_ref = request_ref,
            receipt = receipt,
            error = error,
        )
    }
}
