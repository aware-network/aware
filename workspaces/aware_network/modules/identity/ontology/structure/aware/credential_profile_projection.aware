// Credential profile projection (v0)
//
// Contract:
// - Rooted at CredentialProfile.
// - Exposes secret references, grants, readiness receipts, and usage receipts.
// - Secret values are never projected; only refs, fingerprints, and receipts.
projection CredentialProfile {
    root credential.CredentialProfile

    credential.CredentialProfile::secret_material_refs
    credential.CredentialProfile::grants
    credential.CredentialProfile::readiness_receipts
    credential.CredentialProfile::usage_receipts
}
