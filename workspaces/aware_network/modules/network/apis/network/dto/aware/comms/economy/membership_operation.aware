/// Economy membership operations for the Network Node control-plane (DTO-only).
///
/// These operations are routed via:
/// `NetworkOperation(type=NETWORK_NODE) -> NetworkNodeOperation(request/response)`.
///
/// Canonical rules:
/// - Secrets never appear in clients (Stripe secret key is node-owned).
/// - `actor_id` is taken from the authenticated interface session binding; clients must not spoof it.
/// - Membership gating is enforced by the node/runtime, not by the UI.

/// Read membership state for the authenticated actor.
class MembershipStatusRequest augment aware_network_service_dto.comms.models.NetworkNodeOperationRequest {
    operation String = "membership_status"
}

class MembershipStatusResponse augment aware_network_service_dto.comms.models.NetworkNodeOperationResponse {
    operation String = "membership_status"

    // Attributes
    status String
    error String?
    is_active Bool
    is_bypassed Bool = false
    plan_label String?
    current_period_end String?
}

/// Create a Stripe-hosted checkout session for membership subscription.
///
/// v0:
/// - Node uses its configured Stripe price id(s) and returns a `checkout_url` for redirection.
/// - The request may optionally select a plan key; the node must validate it against its allowlist.
class MembershipCheckoutSessionCreateRequest augment aware_network_service_dto.comms.models.NetworkNodeOperationRequest {
    operation String = "membership_checkout_session_create"

    // Attributes
    plan_key String?
    success_url String?
    cancel_url String?
}

class MembershipCheckoutSessionCreateResponse augment aware_network_service_dto.comms.models.NetworkNodeOperationResponse {
    operation String = "membership_checkout_session_create"

    // Attributes
    status String
    error String?
    checkout_url String?
    checkout_session_id String?
}

/// Prepare a membership purchase flow for the authenticated actor.
///
/// Provider-neutral contract:
/// - Desktop/web may return a Stripe `checkout_url`.
/// - iOS returns an `apple_product_id` for StoreKit purchase.
/// - Android returns a `google_product_id` for Play Billing purchase.
///
/// Canonical: clients must never treat redirects as proof of payment; membership becomes active
/// only after server-side verification (webhook/notification or purchase-claim verification).
class MembershipPurchasePrepareRequest augment aware_network_service_dto.comms.models.NetworkNodeOperationRequest {
    operation String = "membership_purchase_prepare"

    // Attributes
    plan_key String?
    platform String? // e.g. "ios" | "android" | "desktop" | "web"
}

class MembershipPurchasePrepareResponse augment aware_network_service_dto.comms.models.NetworkNodeOperationResponse {
    operation String = "membership_purchase_prepare"

    // Attributes
    status String
    error String?

    // Provider selection (edge detail; canonical membership state is provider-neutral).
    provider String // e.g. "stripe" | "apple_iap" | "google_play"
    plan_label String?

    // Provider-specific purchase parameters (only one is expected per response).
    checkout_url String?
    apple_product_id String?
    google_product_id String?
}

/// Claim/verify a membership purchase.
///
/// This operation exists primarily for store billing (iOS/Android) where the client must initiate
/// the purchase locally and then submit proof for server-side verification.
class MembershipPurchaseClaimRequest augment aware_network_service_dto.comms.models.NetworkNodeOperationRequest {
    operation String = "membership_purchase_claim"

    // Attributes
    provider String
    plan_key String?

    // Apple IAP (StoreKit): receipt/transaction proof (format is provider-defined; server verifies).
    apple_product_id String?
    apple_receipt String?
    apple_transaction_id String?

    // Google Play Billing: purchase token proof (server verifies).
    google_product_id String?
    google_purchase_token String?
}

class MembershipPurchaseClaimResponse augment aware_network_service_dto.comms.models.NetworkNodeOperationResponse {
    operation String = "membership_purchase_claim"

    // Attributes
    status String
    error String?
    is_active Bool
    plan_label String?
    current_period_end String?
}

// Discriminated-union tags (declared here to avoid network -> economy deps).
ann aware_network_service_dto.comms.economy.MembershipStatusRequest::operation discriminate tag "membership_status"
ann aware_network_service_dto.comms.economy.MembershipCheckoutSessionCreateRequest::operation discriminate tag "membership_checkout_session_create"
ann aware_network_service_dto.comms.economy.MembershipPurchasePrepareRequest::operation discriminate tag "membership_purchase_prepare"
ann aware_network_service_dto.comms.economy.MembershipPurchaseClaimRequest::operation discriminate tag "membership_purchase_claim"
ann aware_network_service_dto.comms.economy.MembershipStatusResponse::operation discriminate tag "membership_status"
ann aware_network_service_dto.comms.economy.MembershipCheckoutSessionCreateResponse::operation discriminate tag "membership_checkout_session_create"
ann aware_network_service_dto.comms.economy.MembershipPurchasePrepareResponse::operation discriminate tag "membership_purchase_prepare"
ann aware_network_service_dto.comms.economy.MembershipPurchaseClaimResponse::operation discriminate tag "membership_purchase_claim"
