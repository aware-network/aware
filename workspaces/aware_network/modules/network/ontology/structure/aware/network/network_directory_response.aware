class NetworkDirectoryNodeRouteItem : inline_value {
    node_id UUID
    public_key String?
    hostname String
    port Int
    base_url String?
    status String = "active"
    last_seen_at String?
}

class NetworkDirectoryPeerItem : inline_value {
    edge_id UUID?
    source_node_id UUID
    target_node_id UUID
    peer_node_id UUID
    peer_base_url String
    direction String = "outgoing"
    status String = "accepted"
    trust_score Float = 0.0
    connected_at String?
    last_ping_at String?
}

class NetworkDirectoryHostedServiceItem : inline_value {
    service_id UUID
    service_name String
    service_package_names String[] = []
    endpoint_refs String[] = []
    stream_endpoint_refs String[] = []
    host_id String
    host_version String?
    protocol_version String
    supports_stream_events Bool = false
}

class NetworkDirectoryEnvironmentItem : inline_value {
    node_id UUID?
    environment_id UUID
    environment_key String?
    environment_title String?
    role String = "replica"
    is_active Bool = true
    priority Int = 0
    status String = "active"
    experience_names String[] = []
    environment_config_id UUID?
    environment_config_key String?
}

class NetworkDirectoryTerritoryNodeItem : inline_value {
    node NetworkDirectoryNodeRouteItem
    environments NetworkDirectoryEnvironmentItem[] = []
    hosted_services NetworkDirectoryHostedServiceItem[] = []
    peers NetworkDirectoryPeerItem[] = []
}

class NetworkDirectoryTerritoryResponse : inline_value {
    nodes NetworkDirectoryTerritoryNodeItem[] = []
    summary String?
}

class NetworkDirectoryExperienceServiceCandidate : inline_value {
    hosted_service NetworkDirectoryHostedServiceItem
    provider_node_id UUID
    provider_node_base_url String?
    route_connection_id UUID?
    route_status String = "reachable"
    matched_service_package_names String[] = []
    matched_endpoint_refs String[] = []
    missing_service_package_names String[] = []
    missing_endpoint_refs String[] = []
}

class NetworkDirectoryExperienceTerritoryEntry : inline_value {
    experience_name String
    node NetworkDirectoryNodeRouteItem
    environment NetworkDirectoryEnvironmentItem
    service_candidates NetworkDirectoryExperienceServiceCandidate[] = []
    route_status String = "unavailable"
    missing_service_package_names String[] = []
    missing_endpoint_refs String[] = []
}

class NetworkDirectoryExperienceTerritoryResponse : inline_value {
    experience_name String?
    entries NetworkDirectoryExperienceTerritoryEntry[] = []
    summary String?
}
