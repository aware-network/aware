    token
}

enum ServiceContractOperationQuotaWindow {
    billing_period
    day
    hour
    minute
    month
    none
}

enum ServiceContractOperationQuotaOverLimitBehavior {
    allow_metered
    deny
    throttle
}

enum ServiceContractOperationPermitScope {
    contract
    operation
    session
}

enum ServiceContractOperationPermitIdempotencyScope {
    none
    operation_nonce
    request_hash
}

enum ServiceContractOperationPriceSource {
    contract_override
    operation_default
}

enum ServicePlanCycle {
