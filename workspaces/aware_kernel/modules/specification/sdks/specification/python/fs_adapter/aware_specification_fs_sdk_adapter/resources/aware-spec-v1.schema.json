{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aware:schema:specification:filesystem-manifest:v1",
  "title": "Aware Specification Filesystem Manifest V1",
  "x-aware-schema-identity": "aware.specification.filesystem_manifest",
  "x-aware-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aware",
    "specification",
    "invariants",
    "phases",
    "phase_dependencies",
    "iterations"
  ],
  "properties": {
    "aware": {
      "type": "integer",
      "const": 1
    },
    "specification": {
      "$ref": "#/$defs/specification"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "phase_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/phaseDependency"
      }
    },
    "iterations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/iteration"
      }
    }
  },
  "$defs": {
    "specificationKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "memberKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "phaseRef": {
      "type": "string",
      "pattern": "^specification:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/phase:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "invariantRef": {
      "type": "string",
      "pattern": "^specification:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/invariant:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256Ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semanticRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "entrypointPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//).+$"
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "key",
        "semantic_version",
        "entrypoint",
        "invariant_index",
        "phase_index"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "const": "specification_fs_v1"
        },
        "key": {
          "$ref": "#/$defs/specificationKey"
        },
        "semantic_version": {
          "type": "integer",
          "minimum": 1
        },
        "entrypoint": {
          "type": "string",
          "const": "SPEC.md"
        },
        "invariant_index": {
          "type": "string",
          "const": "invariants/README.md"
        },
        "phase_index": {
          "type": "string",
          "const": "PHASES.md"
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "semantic_revision",
        "entrypoint"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/memberKey"
        },
        "semantic_revision": {
          "type": "integer",
          "minimum": 1
        },
        "entrypoint": {
          "$ref": "#/$defs/entrypointPath"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "ordinal",
        "entrypoint",
        "gate_key",
        "gate_contract",
        "evidence_schema_ref",
        "invariant_refs"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/memberKey"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "entrypoint": {
          "$ref": "#/$defs/entrypointPath"
        },
        "gate_key": {
          "$ref": "#/$defs/memberKey"
        },
        "gate_contract": {
          "$ref": "#/$defs/semanticRef"
        },
        "evidence_schema_ref": {
          "$ref": "#/$defs/semanticRef"
        },
        "invariant_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/invariantRef"
          }
        }
      }
    },
    "phaseDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "owner_phase_ref",
        "kind",
        "required_phase_ref",
        "required_gate_digest",
        "rationale"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/memberKey"
        },
        "owner_phase_ref": {
          "$ref": "#/$defs/phaseRef"
        },
        "kind": {
          "type": "string",
          "const": "requires"
        },
        "required_phase_ref": {
          "$ref": "#/$defs/phaseRef"
        },
        "required_gate_digest": {
          "$ref": "#/$defs/sha256Ref"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "phase_ref",
        "plan_revision",
        "entrypoint"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/memberKey"
        },
        "phase_ref": {
          "$ref": "#/$defs/phaseRef"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "entrypoint": {
          "$ref": "#/$defs/entrypointPath"
        }
      }
    }
  }
}
