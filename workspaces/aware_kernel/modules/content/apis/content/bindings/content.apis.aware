api content {
    capability text {
        endpoint resolve_content_text aware_content_service_dto.content.ResolveContentTextRequest {
            """
            Resolve one Content object into deterministic text parts and a flattened text payload.
            """

            response aware_content_service_dto.content.ResolveContentTextResponse
        }
    }

    capability package {
        endpoint materialize_content_package aware_content_service_dto.content.MaterializeContentPackageRequest {
            """
            Materialize a provider export document into Content-owned ContentPackage truth.
            """

            response aware_content_service_dto.content.MaterializeContentPackageResponse
        }
    }
}
