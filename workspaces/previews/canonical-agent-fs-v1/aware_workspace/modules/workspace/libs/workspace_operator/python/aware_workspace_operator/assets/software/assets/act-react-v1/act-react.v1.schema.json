{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awareos.dev/schemas/act-react.v1.schema.json",
  "title": "ACT-REACT Program IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "program_ref", "steps"],
  "properties": {
    "version": {
      "const": "act-react.v1"
    },
    "program_ref": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "expr": {
      "oneOf": [
        { "$ref": "#/$defs/expr_literal" },
        { "$ref": "#/$defs/expr_local_ref" },
        { "$ref": "#/$defs/expr_symbol_ref" },
        { "$ref": "#/$defs/expr_call" }
      ]
    },
    "expr_literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "literal" },
        "value": true
      }
    },
    "expr_local_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "local_ref" },
        "name": { "$ref": "#/$defs/identifier" }
      }
    },
    "expr_symbol_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "symbol_ref" },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "call_arg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/expr" }
      }
    },
    "expr_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "const": "call" },
        "target": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/call_arg" },
          "default": []
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/step_input" },
        { "$ref": "#/$defs/step_let" },
        { "$ref": "#/$defs/step_expect_event_config" },
        { "$ref": "#/$defs/step_intent_action_config" },
        { "$ref": "#/$defs/step_invoke" }
      ]
    },
    "step_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "kind", "name", "source", "required"],
      "properties": {
        "step_id": { "$ref": "#/$defs/step_id" },
        "kind": { "const": "input" },
        "name": { "$ref": "#/$defs/identifier" },
        "source": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/expr" }
      }
    },
    "step_let": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "kind", "name", "value"],
      "properties": {
        "step_id": { "$ref": "#/$defs/step_id" },
        "kind": { "const": "let" },
        "name": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/expr" }
      }
    },
    "step_expect_event_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "kind", "event_config_ref", "required"],
      "properties": {
        "step_id": { "$ref": "#/$defs/step_id" },
        "kind": { "const": "expect_event_config" },
        "event_config_ref": { "$ref": "#/$defs/identifier" },
        "required": { "type": "boolean" }
      }
    },
    "step_intent_action_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "kind", "action_config_ref", "event_config_ref"],
      "properties": {
        "step_id": { "$ref": "#/$defs/step_id" },
        "kind": { "const": "intent_action_config" },
        "action_config_ref": { "$ref": "#/$defs/identifier" },
        "event_config_ref": { "$ref": "#/$defs/identifier" }
      }
    },
    "step_invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "kind", "invoke_kind", "call"],
      "properties": {
        "step_id": { "$ref": "#/$defs/step_id" },
        "kind": { "const": "invoke" },
        "invoke_kind": {
          "type": "string",
          "enum": ["effect"]
        },
        "call": { "$ref": "#/$defs/expr_call" }
      }
    }
  }
}
