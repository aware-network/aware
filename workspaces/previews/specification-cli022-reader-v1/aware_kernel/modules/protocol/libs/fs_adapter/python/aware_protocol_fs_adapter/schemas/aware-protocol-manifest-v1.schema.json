{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aware:schema:protocol:manifest:v1",
  "title": "Aware Protocol Manifest V1",
  "x-aware-schema-identity": "aware.protocol.manifest",
  "x-aware-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["aware", "protocol", "target", "bootstrap", "records"],
  "properties": {
    "aware": { "type": "integer", "const": 1 },
    "protocol": { "$ref": "#/$defs/protocol" },
    "target": { "$ref": "#/$defs/target" },
    "bootstrap": { "$ref": "#/$defs/bootstrap" },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "issue", "feed", "specification", "evidence"],
      "properties": {
        "goal": { "$ref": "#/$defs/record" },
        "issue": { "$ref": "#/$defs/record" },
        "feed": { "$ref": "#/$defs/record" },
        "specification": { "$ref": "#/$defs/record" },
        "evidence": { "$ref": "#/$defs/record" },
        "project": { "$ref": "#/$defs/record" }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\u0000-\\u001F\\u007F])(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pathTemplate": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\u0000-\\u001F\\u007F])(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "schemaProfile": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        { "pattern": "^aware\\.[a-z0-9_.-]+\\.v[0-9]+$" },
        { "pattern": "^[a-z][a-z0-9_.-]*_v[0-9]+$" }
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile", "semantic_version"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "profile": { "$ref": "#/$defs/schemaProfile" },
        "semantic_version": { "type": "integer", "minimum": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authority_mode"],
      "properties": {
        "kind": { "type": "string", "const": "repository" },
        "authority_mode": {
          "type": "string",
          "enum": ["filesystem", "service_api"]
        },
        "authority_ref": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "authority_mode": { "const": "filesystem" } },
            "required": ["authority_mode"]
          },
          "then": { "not": { "required": ["authority_ref"] } }
        },
        {
          "if": {
            "properties": { "authority_mode": { "const": "service_api" } },
            "required": ["authority_mode"]
          },
          "then": { "required": ["authority_ref"] }
        }
      ]
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_contract"],
      "properties": {
        "agent_contract": { "$ref": "#/$defs/relativePath" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "role"],
      "properties": {
        "profile": { "$ref": "#/$defs/schemaProfile" },
        "role": {
          "type": "string",
          "enum": ["authority", "projection", "bootstrap", "unavailable"]
        },
        "root": { "$ref": "#/$defs/relativePath" },
        "path_template": { "$ref": "#/$defs/pathTemplate" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "unavailable" } },
            "required": ["role"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["root"] },
                { "required": ["path_template"] }
              ]
            }
          },
          "else": { "required": ["root", "path_template"] }
        }
      ]
    }
  }
}
